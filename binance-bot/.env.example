# ===== Binance =====
# مفاتيح Testnet من: https://testnet.binance.vision
# لا تفعّل صلاحية السحب (Withdraw) أبدًا
BINANCE_API_KEY=
BINANCE_API_SECRET=

# true = فلوس وهمية (Testnet). خلها true لين تتأكد من البوت
TESTNET=true
# للتداول الحقيقي: TESTNET=false و CONFIRM_LIVE=YES
CONFIRM_LIVE=

# ===== Discord =====
DISCORD_TOKEN=
# سيرفرك الخاص (عشان الأوامر تظهر فورًا)
GUILD_ID=
# الـ User ID حقك. الأوامر تشتغل لك إنت بس
OWNER_ID=
# القناة اللي يرسل فيها البوت الصفقات والتنبيهات
NOTIFY_CHANNEL_ID=

# ===== الاستراتيجية =====
SYMBOL=BTC/USDT
# طول الشمعة اللي تنحسب عليها الإشارات: 1m | 5m | 15m | 1h | 4h
# أقصر = صفقات أكثر وإشارات كاذبة أكثر وعمولات أكثر
TIMEFRAME=15m
# auto = يختبر 6 استراتيجيات على الأسعار الحقيقية ويختار الأفضل تلقائيًا
# أو اكتب وحدة ثابتة: ema_cross | trend_follow | rsi_bounce | bollinger | breakout | macd_trend
STRATEGY=auto
# كم يوم من الأسعار القديمة يختبر عليها
OPTIMIZE_DAYS=60
# كل كم ساعة يعيد الاختبار ويغير الاستراتيجية لو لقى أفضل
OPTIMIZE_EVERY_HOURS=6

# ===== إدارة المخاطر =====
# كم دولار يدخل في كل صفقة (الحد الأدنى في Binance تقريبًا 5 دولار)
TRADE_AMOUNT_USDT=10
# وقف الخسارة وجني الربح بالنسبة المئوية
STOP_LOSS_PCT=2
TAKE_PROFIT_PCT=4
# إذا خسر هذا المبلغ في يوم واحد يوقف فتح صفقات جديدة لين بكرة
MAX_DAILY_LOSS_USDT=5

# السعر اللحظي يوصل كل ثانية تلقائيًا (WebSocket) ويفحص وقف الخسارة وجني الربح.
# الإشارات تنحسب فور ما تقفل الشمعة، وهذا فحص احتياطي إضافي كل كم ثانية
LOOP_SECONDS=10
