# Required: your Anthropic API key (or run `ant auth login` instead).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: unlocks the materials_project_properties tool (band gaps, formation energies, stability).
# Free key: https://next-gen.materialsproject.org/api
MP_API_KEY=

# Optional: NCBI key raises the PubMed rate limit from 3 to 10 requests/second.
NCBI_API_KEY=

# Optional: OpenAlex key for higher rate limits.
OPENALEX_API_KEY=

# Optional: override the default model (claude-opus-5).
CHEM_AGENT_MODEL=
